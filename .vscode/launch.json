{
    // 每个 Exercise 一个启动配置：按 F5，或在“运行和调试”面板下拉选择题目
    // vmArgs 让 Windows 终端以 UTF-8 输出，Exercise 7 的 \u2500 方框才不会变乱码
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Exercise 1 - Favourite songs",
            "request": "launch",
            "mainClass": "Exercise1",
            "console": "integratedTerminal",
            "vmArgs": "-Dstdout.encoding=UTF-8"
        },
        {
            "type": "java",
            "name": "Exercise 2 - Bubble sort",
            "request": "launch",
            "mainClass": "Exercise2",
